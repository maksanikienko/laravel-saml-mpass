{
    "name": "maksanikienko/laravel-saml-mpass",
    "description": "Laravel package for SAML 2.0 authentication via MPass — the Republic of Moldova government SSO/SLO service.",
    "keywords": ["laravel", "saml", "mpass", "sso", "authentication", "moldova"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Maxim Anichienco",
            "email": "maksanikienko30@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "onelogin/php-saml": "^4.3.2"
    },
    "autoload": {
        "psr-4": {
            "Mpass\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mpass\\MpassServiceProvider"
            ],
            "aliases": {
                "Mpass": "Mpass\\Facades\\Mpass"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
